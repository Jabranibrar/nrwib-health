{
  "name": "nextjs-boilerplate",
  "description": "Next.js boilerplate with husky, lint-staged, eslint + prettier, storybook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prettier:format": "prettier --write .",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "lint": "next lint",
    "lint:format": "eslint src --fix",
    "postinstall": "husky install",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "generate:icon-list": "node ./scripts/generateIconsList.js",
    "spritegen": "npx svg-sprite -s --symbol-dest public --symbol-sprite sprite.svg icons/*.svg && npm run generate:icon-list"
  },
  "dependencies": {
    "@apollo/client": "^3.10.4",
    "@headlessui/react": "^2.0.3",
    "@heroicons/react": "^2.1.3",
    "@iframe-resizer/react": "^5.3.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "animate.css": "^4.1.1",
    "axios": "^1.6.8",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "country-list-js": "^3.1.8",
    "dayjs": "^1.11.11",
    "dompurify": "^3.1.3",
    "formidable": "^3.5.1",
    "formik": "^2.4.6",
    "framer-motion": "^11.3.30",
    "fuzzy-search": "^3.2.1",
    "globalize": "0.1.1",
    "graphql": "^16.8.1",
    "html-entities": "^2.5.2",
    "leaflet": "^1.9.4",
    "leaflet-responsive-popup": "^1.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "next": "14.2.3",
    "next-seo": "^6.5.0",
    "path": "^0.12.7",
    "precss": "^4.0.0",
    "prop-types": "^15.8.1",
    "pure-react-carousel": "^1.30.1",
    "react": "^18",
    "react-big-calendar": "^1.13.4",
    "react-countup": "^6.5.3",
    "react-datepicker": "^7.3.0",
    "react-dates": "^21.8.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18",
    "react-icons": "^5.2.1",
    "react-input-mask": "^2.0.4",
    "react-instantsearch": "^7.8.1",
    "react-instantsearch-dom": "^6.40.4",
    "react-leaflet": "^4.2.1",
    "react-modal": "^3.16.1",
    "react-paginate": "^8.2.0",
    "react-player": "^2.16.0",
    "react-select": "^5.8.0",
    "react-slick": "^0.30.2",
    "sass": "^1.77.1",
    "slick-carousel": "^1.8.1",
    "swiper": "^11.1.4",
    "swr": "^2.2.5",
    "typesense-instantsearch-adapter": "^2.8.0",
    "uuid": "^9.0.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.3.3",
    "@storybook/addon-essentials": "^8.0.9",
    "@storybook/addon-interactions": "^8.0.9",
    "@storybook/addon-links": "^8.0.9",
    "@storybook/blocks": "^8.0.9",
    "@storybook/builder-webpack5": "^8.0.9",
    "@storybook/manager-webpack5": "^6.5.16",
    "@storybook/nextjs": "^8.0.9",
    "@storybook/react": "^8.0.9",
    "@storybook/test": "^8.0.9",
    "@types/autoprefixer": "^10.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "eslint-plugin-storybook": "^0.8.0",
    "husky": "^9.1.5",
    "postcss": "^8",
    "react-video-thumbnail": "^0.1.3",
    "react-xmasonry": "^3.0.6",
    "storybook": "^8.0.9",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1"
  },
  "lint-staged": {
    "src/**/*": [
      "npm prettier:format",
      "npm eslint:format"
    ]
  }
}
